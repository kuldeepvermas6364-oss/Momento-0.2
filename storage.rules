rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ============================================================
    // AVATARS — public read, owner write
    // ============================================================
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ============================================================
    // POSTS — public read, owner write
    // ============================================================
    match /posts/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ============================================================
    // STORIES — public read, owner write
    // ============================================================
    match /stories/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ============================================================
    // REELS — public read, owner write
    // ============================================================
    match /reels/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ============================================================
    // MESSAGES — sender or receiver only
    // ============================================================
    match /messages/{userId}/{fileName} {
      allow read: if request.auth != null
        && (request.auth.uid == userId
          || request.auth.uid == request.resource.data.receiver_id);
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
